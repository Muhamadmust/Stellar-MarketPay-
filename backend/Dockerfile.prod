FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY --chown=node:node . .
RUN chown -R node:node /app

ENV NODE_ENV=production \
    PORT=4000

USER node

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "const http=require('http');const r=http.get('http://127.0.0.1:4000/api/health/db',res=>{res.resume();process.exit(res.statusCode===200?0:1)});r.setTimeout(4000,()=>r.destroy());r.on('error',()=>process.exit(1))"]

CMD ["node", "src/server.js"]
